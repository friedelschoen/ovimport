<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>nl.halteradar</groupId>
  <artifactId>netex-java</artifactId>
  <version>0.1.0</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration />
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>nl.halteradar.App</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
        <version>4.0.16</version>
        <executions>
          <execution>
            <id>generate-netex</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <schemaDirectory>src/main/resources/xsd/netex</schemaDirectory>
              <schemaIncludes>
                <include>netex-nl-geen-constraints.xsd</include>
              </schemaIncludes>
              <generatePackage>nl.bisonnl.netex</generatePackage>
              <generateDirectory>${project.build.directory}/generated-sources/xjc/netex</generateDirectory>
              <extension>true</extension>
              <strict>false</strict>
            </configuration>
          </execution>
          <execution>
            <id>generate-chb</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <schemaDirectory>src/main/resources/xsd/chb</schemaDirectory>
              <schemaIncludes>
                <include>chb.842-msg.xsd</include>
              </schemaIncludes>
              <generatePackage>nl.bisonnl.chb</generatePackage>
              <generateDirectory>${project.build.directory}/generated-sources/xjc/chb</generateDirectory>
              <extension>true</extension>
              <strict>false</strict>
            </configuration>
          </execution>
          <execution>
            <id>generate-psa</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <schemaDirectory>src/main/resources/xsd/psa</schemaDirectory>
              <schemaIncludes>
                <include>passengerstopassignment.xsd</include>
              </schemaIncludes>
              <generatePackage>nl.bisonnl.psa</generatePackage>
              <generateDirectory>${project.build.directory}/generated-sources/xjc/psa</generateDirectory>
              <extension>true</extension>
              <strict>false</strict>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <jaxb.version>4.0.5</jaxb.version>
  </properties>
</project>
